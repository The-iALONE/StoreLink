{
    "name": "storelink/storelink",
    "description": "Connect WooCommerce to messengers such as Telegram",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "StoreLink\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StoreLink\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
