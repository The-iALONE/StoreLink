msgstr "تنظیم موجودی"

msgid "Send the stock quantity as a number."
msgstr "موجودی را به صورت عدد بفرستید."

msgid "Send the quantity for %s as a number."
msgstr "تعداد %s را به صورت عدد بفرستید."

msgid "Send the quantity as a number."
msgstr "تعداد را به صورت عدد بفرستید."

