msgstr "صف انتشار"

msgid "Saves settings, then queues one job per product. Existing channel posts are edited. A new post is only sent when none is stored or the message is gone."
msgstr "تنظیمات ذخیره می‌شود، بعد برای هر محصول یک کار در صف می‌رود. پست موجود ویرایش می‌شود. پست جدید فقط وقتی است که شناسه‌ای ذخیره نشده یا پیام در کانال نیست."

msgid "General"
msgstr "عمومی"

msgid "Connection"
msgstr "اتصال"

msgid "Bot shop"
msgstr "فروشگاه ربات"

msgid "Notifications"
msgstr "اعلان‌ها"

msgid "Channel"
msgstr "کانال"

msgid "Required on localhost."
msgstr "روی لوکال‌هاست لازم است."

msgid "Paste your public HTTPS origin (ngrok or Cloudflare Tunnel)."
msgstr "آدرس HTTPS عمومی را بگذارید (ngrok یا Cloudflare Tunnel)."

msgid "Leave empty if this WordPress site is already public HTTPS."
msgstr "اگر خود سایت وردپرس از قبل HTTPS عمومی است، خالی بگذارید."

msgid "Only orders with a physical item."
msgstr "فقط سفارش با کالای فیزیکی."

msgid "Set carrier and number on the WooCommerce order or from the Telegram admin bot."
msgstr "حامل و شماره را روی سفارش ووکامرس یا از ربات ادمین تلگرام بگذارید."

msgid "Iran Post and Tipax open their official pages. Local courier has no tracking website."
msgstr "پست ایران و تیپاکس صفحه رسمی را باز می‌کنند. پیک محلی سایت رهگیری ندارد."

msgid "Carrier sites are not scraped."
msgstr "از سایت حامل چیزی خوانده نمی‌شود."

msgid "A separate Telegram message when tracking is saved needs the customer tracking checkbox under Bot notifications."
msgstr "پیام جدا در تلگرام هنگام ذخیره فقط اگر تیک پیام رهگیری مشتری در اعلان‌های ربات روشن باشد."

msgid "My orders and status messages can still show the number."
msgstr "در سفارش‌های من و پیام تغییر وضعیت، شماره همچنان می‌تواند دیده شود."

msgid "Show the WooCommerce default category (Uncategorized) in the bot category menu."
msgstr "دسته پیش‌فرض ووکامرس (دسته‌بندی‌نشده) را در منوی دسته‌های ربات نشان بده."

msgid "Products stay in the full catalog and search either way."
msgstr "کالاها در هر دو حالت در فهرست همه محصولات و جستجو می‌مانند."

msgid "This does not change the store website."
msgstr "وب‌سایت فروشگاه عوض نمی‌شود."

msgid "If the cart is only downloadable products with price 0, skip name, address, shipping and payment."
msgstr "اگر سبد فقط کالای دانلودی با قیمت صفر باشد، نام، آدرس، ارسال و پرداخت رد می‌شود."

msgid "Complete the WooCommerce order and send download links in the bot."
msgstr "سفارش ووکامرس تکمیل می‌شود و لینک دانلود در ربات می‌آید."

msgid "Product IDs"
msgstr "شناسه محصول"

msgid "Published simple or variable products."
msgstr "محصول ساده یا متغیر منتشرشده."

msgid "Separate IDs with a comma or a space."
msgstr "شناسه‌ها را با ویرگول یا فاصله جدا کنید."

msgid "Saves settings, then queues one job per product."
msgstr "تنظیمات ذخیره می‌شود، بعد برای هر محصول یک کار در صف می‌رود."

msgid "Existing channel posts are edited."
msgstr "پست موجود ویرایش می‌شود."

msgid "A new post is only sent when none is stored or the message is gone."
msgstr "پست جدید فقط وقتی است که شناسه‌ای ذخیره نشده یا پیام در کانال نیست."

msgid "Bale uses the same shop as Telegram (catalog, cart, my orders, admin)."
msgstr "بله همان فروشگاه تلگرام را دارد (کاتالوگ، سبد، سفارش‌های من، ادمین)."

msgid "Enable the bot, save the token, connect the webhook, then /start."
msgstr "ربات را فعال کنید، توکن را ذخیره کنید، وب‌هوک را وصل کنید، بعد /start."

msgid "Token is stored encrypted."
msgstr "توکن رمزنگاری‌شده ذخیره می‌شود."

msgid "Leave the masked value unchanged to keep the current token."
msgstr "اگر مقدار ماسک‌شده را عوض نکنید، توکن فعلی می‌ماند."

msgid "Optional. PHP calls to api.telegram.org (setWebhook, replies)."
msgstr "اختیاری. تماس PHP به api.telegram.org (setWebhook و پاسخ‌ها)."

msgid "Example: socks5://127.0.0.1:10808 for V2Ray."
msgstr "مثال برای V2Ray: socks5://127.0.0.1:10808"

msgid "Incoming webhooks still need public HTTPS."
msgstr "وب‌هوک ورودی همچنان HTTPS عمومی می‌خواهد."

msgid "For Iranian shared hosting: PHP cannot reach api.telegram.org and cannot use a local SOCKS proxy."
msgstr "برای هاست اشتراکی ایران: PHP به api.telegram.org نمی‌رسد و SOCKS لوکال هم ندارد."

msgid "Deploy the sample Cloudflare Worker in tools/cloudflare-telegram-relay.js and paste its HTTPS origin here."
msgstr "Worker نمونه در tools/cloudflare-telegram-relay.js را دیپلوی کنید و آدرس HTTPS آن را اینجا بگذارید."

msgid "This replaces api.telegram.org for outbound calls only."
msgstr "فقط تماس خروجی جایگزین api.telegram.org می‌شود."

msgid "Incoming webhooks still need a public HTTPS site URL."
msgstr "وب‌هوک ورودی همچنان HTTPS عمومی سایت است."

msgid "Numeric Telegram user IDs (comma-separated)."
msgstr "شناسه عددی کاربر تلگرام (با ویرگول)."

msgid "Those users see Orders in the bot."
msgstr "همان کاربران در ربات سفارش‌ها را می‌بینند."

msgid "They must send /start once so order alerts can be delivered."
msgstr "یک‌بار /start بزنند تا اعلان سفارش برسد."

msgid "Numeric Bale user IDs."
msgstr "شناسه عددی کاربر بله."

msgid "Same shop and admin order contract as Telegram."
msgstr "همان فروشگاه و مدیریت سفارش تلگرام."

msgid "Send /start in the Bale bot once for alerts."
msgstr "یک‌بار در ربات بله /start بزنید تا اعلان برسد."

msgid "Add the bot as admin."
msgstr "ربات را ادمین کانال کنید."

msgid "Price/stock changes post or edit using the caption fields on the General tab."
msgstr "تغییر قیمت/موجودی با فیلدهای کپشن در تب عمومی پست یا ویرایش می‌شود."

msgid "No AI."
msgstr "بدون هوش مصنوعی."

msgid "Rubika"
msgstr "روبیکا"

msgid "Connect WooCommerce to Telegram, Bale, and Rubika. Other messengers can be added through the gateway interface."
msgstr "ووکامرس را به تلگرام، بله و روبیکا وصل کنید. پیام‌رسان دیگر از همین رابط gateway اضافه می‌شود."

msgid "%s uses the same shop as Telegram (catalog, cart, my orders, admin)."
msgstr "%s همان فروشگاه تلگرام را دارد (کاتالوگ، سبد، سفارش‌های من، ادمین)."

msgid "This messenger is not registered."
msgstr "این پیام‌رسان ثبت نشده است."

msgid "%s API is reachable."
msgstr "API %s در دسترس است."

msgid "Test API"
msgstr "تست API"

msgid "Test getMe"
msgstr "تست getMe"

msgid "%s admin user IDs"
msgstr "شناسه ادمین %s"

msgid "Rubika user IDs from /start (they look like u…)."
msgstr "شناسه کاربر روبیکا از /start (معمولاً با u شروع می‌شود)."

msgid "Numeric %s user IDs (comma-separated)."
msgstr "شناسه عددی کاربر %s (با ویرگول)."

msgid "%s channel"
msgstr "کانال %s"

msgid "Rubika only accepts a public HTTPS webhook. Local http:// URLs are rejected. Use a tunnel such as ngrok and set the public webhook base URL."
msgstr "روبیکا فقط وب‌هوک HTTPS عمومی می‌پذیرد. آدرس http محلی رد می‌شود. از تونل مثل ngrok و آدرس پایه وب‌هوک استفاده کنید."

msgid "Rubika rejects webhook URLs with a query string. Set Public webhook base URL to HTTPS and use pretty permalinks so the address uses /wp-json/."
msgstr "روبیکا URL وب‌هوک با query string را رد می‌کند. آدرس پایه HTTPS و پیوندهای یکتا را طوری بگذارید که مسیر /wp-json/ باشد."
