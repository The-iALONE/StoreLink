msgstr "%1$s (صفحه %2$d از %3$d)"

msgid "Bot categories"
msgstr "دسته‌های ربات"

msgid "Show the WooCommerce default category (Uncategorized) in the bot category menu. Products stay in the full catalog and search either way. This does not change the store website."
msgstr "دسته پیش‌فرض ووکامرس (دسته‌بندی‌نشده) را در منوی دسته‌های ربات نشان بده. کالاها در هر دو حالت در فهرست همه محصولات و جستجو می‌مانند. وب‌سایت فروشگاه عوض نمی‌شود."

msgid "Bot notifications"
msgstr "اعلان‌های ربات"

msgid "Store: new order (default on)"
msgstr "فروشگاه: سفارش جدید (پیش‌فرض روشن)"

